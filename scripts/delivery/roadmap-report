#!/usr/bin/env python3
# roadmap-report — Generate a markdown report from roadmap-status JSON
#
# Reads JSON from stdin (piped from roadmap-status) or from a file,
# and produces a formatted markdown report.
#
# Usage:
#   ./roadmap-status | ./roadmap-report
#   ./roadmap-status | ./roadmap-report --output reports/custom.md
#   ./roadmap-report --input data.json
#
# Options:
#   --input FILE     Read JSON from file instead of stdin
#   --output FILE    Output file (default: delivery/reports/roadmap-status-YYYY-MM-DD.md)
#   --help

import argparse
import json
import os
import sys
from datetime import date, datetime
from collections import defaultdict

SCRIPT_DIR  = os.path.dirname(os.path.abspath(__file__))
REPO_ROOT   = os.path.dirname(os.path.dirname(SCRIPT_DIR))
REPORTS_DIR = os.path.join(SCRIPT_DIR, "reports")

parser = argparse.ArgumentParser(
    description="Generate markdown report from roadmap-status JSON",
    formatter_class=argparse.RawDescriptionHelpFormatter,
    epilog=(
        "Examples:\n"
        "  ./roadmap-status | ./roadmap-report\n"
        "  ./roadmap-report --input data.json --output report.md"
    ),
)
parser.add_argument("--input",  default=None, help="Read JSON from file (default: stdin)")
parser.add_argument("--output", default=None, help="Output markdown file")
args = parser.parse_args()

if args.input:
    with open(args.input) as f:
        data = json.load(f)
else:
    import select, subprocess, tempfile
    has_stdin = bool(select.select([sys.stdin], [], [], 0)[0])
    if has_stdin:
        data = json.load(sys.stdin)
    else:
        roadmap_status = os.path.join(SCRIPT_DIR, "roadmap-status")
        print("No input provided — running roadmap-status...", file=sys.stderr)
        tmp_fd, tmp_path = tempfile.mkstemp(suffix=".json")
        with os.fdopen(tmp_fd, "w") as tmp_f:
            result = subprocess.run([roadmap_status], stdout=tmp_f, stderr=sys.stderr)
        if result.returncode != 0:
            os.unlink(tmp_path)
            sys.exit(1)
        with open(tmp_path) as f:
            data = json.load(f)
        os.unlink(tmp_path)

today = date.today()

def parse_date(s):
    if not s:
        return None
    try:
        return datetime.strptime(s[:10], "%Y-%m-%d").date()
    except ValueError:
        return None

def format_date(s):
    d = parse_date(s)
    if not d:
        return "-"
    return d.strftime("%b %d, %Y")

def epic_link(e):
    return f"[{e['key']}]({e['url']})"

def days_overdue(s):
    d = parse_date(s)
    if not d:
        return 0
    return (today - d).days

def group_by_project(epics):
    groups = defaultdict(list)
    for e in epics:
        groups[e["project"]].append(e)
    return dict(sorted(groups.items()))

out = []
w   = out.append

generated = data.get("generated", "")[:16].replace("T", " ")
projects_str = ", ".join(data.get("projects", []))
delivered_window = data.get("delivered_window_days", 30)

w(f"# Roadmap Status — {today.strftime('%b %d, %Y')}\n")
w(f"**Projects:** {projects_str}  ")
w(f"**Generated:** {generated}\n")

# ── Delayed ───────────────────────────────────────────────────────────────

delayed = data.get("delayed", [])
w(f"---\n## 🔴 Delayed ({len(delayed)})\n")

if delayed:
    for proj, epics in group_by_project(delayed).items():
        w(f"**{proj}**\n")
        w("| Epic | Summary | Date | Days Overdue | Status |")
        w("|------|---------|------|-------------|--------|")
        for e in epics:
            overdue = days_overdue(e["date"])
            label   = e.get("date_label") or ""
            w(f"| {epic_link(e)} | {e['summary']} "
              f"| {format_date(e['date'])} ({label}) | {overdue}d | {e['status']} |")
        w("")
else:
    w("No delayed epics.\n")

# ── In Progress / On Time ────────────────────────────────────────────────

in_progress = data.get("in_progress", [])
w(f"---\n## 🟢 In Progress — On Time ({len(in_progress)})\n")

if in_progress:
    for proj, epics in group_by_project(in_progress).items():
        w(f"**{proj}**\n")
        w("| Epic | Summary | Date | Status |")
        w("|------|---------|------|--------|")
        for e in epics:
            label = e.get("date_label") or ""
            w(f"| {epic_link(e)} | {e['summary']} "
              f"| {format_date(e['date'])} ({label}) | {e['status']} |")
        w("")
else:
    w("No in-progress epics.\n")

# ── Due Soon ─────────────────────────────────────────────────────────────

due_soon = data.get("due_soon", [])
w(f"---\n## ⏰ Due in the Next 2 Weeks ({len(due_soon)})\n")

if due_soon:
    for proj, epics in group_by_project(due_soon).items():
        w(f"**{proj}**\n")
        w("| Epic | Summary | Date | Days Left | Status |")
        w("|------|---------|------|-----------|--------|")
        for e in epics:
            d = parse_date(e["date"])
            days_left = (d - today).days if d else "-"
            label     = e.get("date_label") or ""
            w(f"| {epic_link(e)} | {e['summary']} "
              f"| {format_date(e['date'])} ({label}) | {days_left}d | {e['status']} |")
        w("")
else:
    w("No epics due in the next 2 weeks.\n")

# ── Recently Delivered ───────────────────────────────────────────────────

delivered = data.get("delivered", [])
w(f"---\n## ✅ Recently Delivered — last {delivered_window} days ({len(delivered)})\n")

if delivered:
    for proj, epics in group_by_project(delivered).items():
        w(f"**{proj}**\n")
        w("| Epic | Summary | Status |")
        w("|------|---------|--------|")
        for e in epics:
            w(f"| {epic_link(e)} | {e['summary']} | {e['status']} |")
        w("")
else:
    w(f"No epics delivered in the last {delivered_window} days.\n")

# ── Warnings ─────────────────────────────────────────────────────────────

warnings     = data.get("warnings", {})
warning_defs = data.get("warning_defs", {})
total_warnings = sum(len(v) for v in warnings.values())
w(f"---\n## ⚠️ Warnings ({total_warnings})\n")

def warn_title(key):
    return warning_defs.get(key, {}).get("title", key)

def warn_desc(key):
    return warning_defs.get(key, {}).get("description", "")

if total_warnings == 0:
    w("No warnings.\n")
else:
    warn = warnings.get("not_started", [])
    if warn:
        w(f"### {warn_title('not_started')} ({len(warn)})\n")
        w(f"{warn_desc('not_started')}\n")
        for proj, epics in group_by_project(warn).items():
            w(f"**{proj}**\n")
            w("| Epic | Summary | Epic Status | Children In Progress |")
            w("|------|---------|-------------|----------------------|")
            for e in epics:
                w(f"| {epic_link(e)} | {e['summary']} "
                  f"| {e['status']} | {e['children_in_progress']} |")
            w("")

    warn = warnings.get("ready_close", [])
    if warn:
        w(f"### {warn_title('ready_close')} ({len(warn)})\n")
        w(f"{warn_desc('ready_close')}\n")
        for proj, epics in group_by_project(warn).items():
            w(f"**{proj}**\n")
            w("| Epic | Summary | Children Done |")
            w("|------|---------|---------------|")
            for e in epics:
                w(f"| {epic_link(e)} | {e['summary']} | {e['children_done']} |")
            w("")

    warn = warnings.get("no_date", [])
    if warn:
        w(f"### {warn_title('no_date')} ({len(warn)})\n")
        w(f"{warn_desc('no_date')}\n")
        for proj, epics in group_by_project(warn).items():
            w(f"**{proj}**\n")
            w("| Epic | Summary | Status |")
            w("|------|---------|--------|")
            for e in epics:
                w(f"| {epic_link(e)} | {e['summary']} | {e['status']} |")
            w("")

    warn = warnings.get("empty", [])
    if warn:
        w(f"### {warn_title('empty')} ({len(warn)})\n")
        w(f"{warn_desc('empty')}\n")
        for proj, epics in group_by_project(warn).items():
            w(f"**{proj}**\n")
            w("| Epic | Summary |")
            w("|------|---------|")
            for e in epics:
                w(f"| {epic_link(e)} | {e['summary']} |")
            w("")

    warn = warnings.get("at_risk", [])
    if warn:
        w(f"### {warn_title('at_risk')} ({len(warn)})\n")
        w(f"{warn_desc('at_risk')}\n")
        for proj, epics in group_by_project(warn).items():
            w(f"**{proj}**\n")
            w("| Epic | Summary | Due Date | Story Points |")
            w("|------|---------|----------|-------------|")
            for e in epics:
                w(f"| {epic_link(e)} | {e['summary']} "
                  f"| {format_date(e['date'])} | {e['done_sp']}/{e['total_sp']} SP ({e['pct']}%) |")
            w("")

    warn = warnings.get("due_not_started", [])
    if warn:
        w(f"### {warn_title('due_not_started')} ({len(warn)})\n")
        w(f"{warn_desc('due_not_started')}\n")
        for proj, epics in group_by_project(sorted(warn, key=lambda x: x["days_left"])).items():
            w(f"**{proj}**\n")
            w("| Epic | Summary | Due Date | Days Left | Status | Children |")
            w("|------|---------|----------|-----------|--------|----------|")
            for e in epics:
                days_str = f"{e['days_left']}d" if e["days_left"] >= 0 else f"{abs(e['days_left'])}d overdue"
                children_str = f"{e['children_done']}/{e['children_total']}" if e["children_total"] > 0 else "none"
                w(f"| {epic_link(e)} | {e['summary']} "
                  f"| {format_date(e['date'])} | {days_str} | {e['status']} | {children_str} |")
            w("")

# ── Upcoming ─────────────────────────────────────────────────────────────

upcoming = data.get("upcoming", [])
w(f"---\n## 📅 Upcoming ({len(upcoming)})\n")

if upcoming:
    by_month = defaultdict(list)
    no_date  = []
    for e in upcoming:
        d = parse_date(e["date"])
        if d:
            by_month[d.strftime("%Y-%m")].append(e)
        else:
            no_date.append(e)

    for month_key in sorted(by_month.keys()):
        month_label = datetime.strptime(month_key, "%Y-%m").strftime("%B %Y")
        w(f"### {month_label}\n")
        for proj, epics in group_by_project(by_month[month_key]).items():
            w(f"**{proj}**\n")
            for e in sorted(epics, key=lambda x: x["date"] or ""):
                label    = e.get("date_label") or ""
                d        = parse_date(e["date"])
                date_tag = f"{d.strftime('%b %d')} ({label})" if d else ""
                w(f"- {epic_link(e)} {e['summary']}  "
                  f"<sub>{date_tag} · {e['status']}</sub>")
            w("")

    if no_date:
        w("### No Date Set\n")
        for proj, epics in group_by_project(no_date).items():
            w(f"**{proj}**\n")
            for e in epics:
                w(f"- {epic_link(e)} {e['summary']}  "
                  f"<sub>{e['status']}</sub>")
            w("")
else:
    w("No upcoming epics with a target/due date beyond 2 weeks.\n")

# ── Summary footer ───────────────────────────────────────────────────────

total = len(delayed) + len(in_progress) + len(due_soon) + len(delivered) + len(upcoming)
w(f"\n---\n*{total} epics — {len(delayed)} delayed, {len(in_progress)} in progress, "
  f"{len(due_soon)} due soon, {len(delivered)} delivered, {len(upcoming)} upcoming, "
  f"{total_warnings} warning(s)*")

# ── Write output ─────────────────────────────────────────────────────────

report_text = "\n".join(out) + "\n"

os.makedirs(REPORTS_DIR, exist_ok=True)
outfile = args.output or os.path.join(REPORTS_DIR, f"roadmap-status-{today}.md")

with open(outfile, "w") as f:
    f.write(report_text)

print(f"Report written to {outfile}", file=sys.stderr)
print(outfile)
