#!/usr/bin/env python3
# dev-progress-weekly-report — Per-developer git and Jira progress report
#
# Assesses each developer's progress: git commits and GitHub PRs for the period,
# linked to the Jira stories and epics they are working on.
# Covers all configured repos. Saves a markdown report to delivery/reports/.
#
# Usage:
#   ./dev-progress-weekly-report
#   ./dev-progress-weekly-report --week 2026-02-15
#   ./dev-progress-weekly-report --from 2026-02-23 --to 2026-02-27
#
# Options:
#   --config FILE    Repo list (default: config/repos.conf)
#   --aliases FILE   Author aliases file (default: config/author-aliases.conf)
#   --projects FILE  Project groups config (default: config/projects.conf)
#   --workspace DIR  Root dir for repos (default: ~/workspace)
#   --week DATE      Any date in the target week (default: current week)
#   --from DATE      Explicit start date (overrides --week)
#   --to DATE        Explicit end date (overrides --week)
#   --output FILE    Output file (default: reports/dev-progress-weekly-report-YYYY-MM-DD.md)
#   --help
#
# Credentials (both optional):
#   GitHub: gh auth login
#   Jira:   ~/.config/jira/.env with JIRA_EMAIL, JIRA_API_TOKEN

import argparse
import base64
import configparser
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
import urllib.error
from collections import defaultdict
from datetime import date, datetime, timedelta

# ─── Paths ────────────────────────────────────────────────────────────────────

SCRIPT_DIR  = os.path.dirname(os.path.abspath(__file__))
REPO_ROOT   = os.path.dirname(os.path.dirname(SCRIPT_DIR))
CONFIG_DIR  = os.path.join(REPO_ROOT, "config")
REPORTS_DIR = os.path.join(SCRIPT_DIR, "reports")
FETCH_STAMP = os.path.join(REPO_ROOT, ".last-fetch")
FETCH_TTL   = 7200  # 2 hours

# ─── Argument parsing ─────────────────────────────────────────────────────────

parser = argparse.ArgumentParser(
    description="Per-developer git and Jira progress report",
    formatter_class=argparse.RawDescriptionHelpFormatter,
    epilog=(
        "Examples:\n"
        "  ./dev-progress-weekly-report\n"
        "  ./dev-progress-weekly-report --week 2026-02-15\n"
        "  ./dev-progress-weekly-report --from 2026-02-23 --to 2026-02-27"
    ),
)
parser.add_argument("--config",    default=None, help="Repo list config file")
parser.add_argument("--aliases",   default=None, help="Author aliases file")
parser.add_argument("--projects", default=None, help="Project groups config file")
parser.add_argument("--workspace", default=None, help="Root dir for repos")
parser.add_argument("--week",      default=None, metavar="DATE", help="Any date in the target week")
parser.add_argument("--from",      default=None, dest="date_from", metavar="DATE")
parser.add_argument("--to",        default=None, dest="date_to",   metavar="DATE")
parser.add_argument("--output",    default=None, help="Output markdown file")
args = parser.parse_args()

WORKSPACE = args.workspace or os.environ.get("REPOS_WORKSPACE", os.path.expanduser("~/Apps"))

# ─── Config loaders ───────────────────────────────────────────────────────────

def load_repos(path):
    repos = []
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) >= 3:
                name, dir_name, url = parts[0].strip(), parts[1].strip(), parts[2].strip()
            else:
                url      = parts[0].strip()
                dir_name = url.rstrip("/").rsplit("/", 1)[-1].replace(".git", "")
                name     = dir_name
            repos.append({"name": name, "dir": dir_name, "url": url})
    return repos

def load_aliases(path):
    alias_map = {}
    if not path or not os.path.isfile(path):
        return alias_map
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts    = line.split("\t")
            canonical = parts[0].strip()
            alias_map[canonical.lower()] = canonical
            for alias in parts[1:]:
                alias = alias.strip()
                if alias:
                    alias_map[alias.lower()] = canonical
    return alias_map

def load_projects_conf(path):
    """Return repo_dir -> project_name and repo_name -> project_name lookups."""
    repo_to_project = {}
    if not path or not os.path.isfile(path):
        return repo_to_project
    cp = configparser.ConfigParser(allow_no_value=True)
    cp.read(path)
    for section in cp.sections():
        for repo_dir in (r.strip() for r in cp.get(section, "repos", fallback="").split(",") if r.strip()):
            repo_to_project[repo_dir] = section
    return repo_to_project

def load_simple_conf(path):
    settings = {}
    if not path or not os.path.isfile(path):
        return settings
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            settings[k.strip()] = v.strip()
    return settings

# ─── Resolve config paths ─────────────────────────────────────────────────────

def find_file(*candidates):
    for p in candidates:
        if p and os.path.isfile(p):
            return p
    return None

repos_path   = find_file(args.config, os.path.join(CONFIG_DIR, "repos.conf"), "repos.conf")
aliases_path = find_file(args.aliases, os.path.join(CONFIG_DIR, "author-aliases.conf"))
projects_path = find_file(args.projects, os.path.join(CONFIG_DIR, "projects.conf"))

if not repos_path:
    print("Error: No repos.conf found. Use --config FILE.", file=sys.stderr)
    sys.exit(1)

repos      = load_repos(repos_path)
alias_map  = load_aliases(aliases_path)
repo_to_project = load_projects_conf(projects_path)

# Build repos.conf display name -> repo dir lookup
proj_to_dir = {r["name"]: r["dir"] for r in repos}

def resolve_author(name):
    return alias_map.get(name.lower(), name)

def project_for_repo(repo_name):
    repo_dir = proj_to_dir.get(repo_name, "")
    return repo_to_project.get(repo_dir, repo_name)

# ─── Date range ───────────────────────────────────────────────────────────────

today = date.today()

if args.date_from and args.date_to:
    date_from = datetime.strptime(args.date_from, "%Y-%m-%d").date()
    date_to   = datetime.strptime(args.date_to,   "%Y-%m-%d").date()
elif args.week:
    ref       = datetime.strptime(args.week, "%Y-%m-%d").date()
    date_from = ref - timedelta(days=ref.weekday())
    date_to   = date_from + timedelta(days=6)
else:
    date_from = today - timedelta(days=today.weekday())
    date_to   = today

git_until = date_to + timedelta(days=1)
print(f"Report period: {date_from} to {date_to}", file=sys.stderr)

# ─── Jira credentials ─────────────────────────────────────────────────────────

jira_env    = os.environ.get("JIRA_ENV_FILE", os.path.expanduser("~/.config/jira/.env"))
jira_config = load_simple_conf(jira_env)
JIRA_EMAIL  = jira_config.get("JIRA_EMAIL", "")
JIRA_TOKEN  = jira_config.get("JIRA_API_TOKEN", "")
JIRA_URL    = jira_config.get("JIRA_BASE_URL", "https://leadtech.atlassian.net").rstrip("/")
JIRA_AUTH   = base64.b64encode(f"{JIRA_EMAIL}:{JIRA_TOKEN}".encode()).decode() if JIRA_EMAIL and JIRA_TOKEN else ""

if not JIRA_AUTH:
    print(f"Note: No Jira credentials ({jira_env}). Issue/epic lookup will be skipped.", file=sys.stderr)

# ─── GitHub CLI check ─────────────────────────────────────────────────────────

gh_check = subprocess.run(["gh", "auth", "status"], capture_output=True)
GH_AVAILABLE = gh_check.returncode == 0
if not GH_AVAILABLE:
    print("Note: GitHub CLI (gh) not authenticated. PR data will be skipped.", file=sys.stderr)
    print("  Run: gh auth login", file=sys.stderr)

# ─── Git fetch (throttled to once per 2h) ────────────────────────────────────

do_fetch = True
if os.path.isfile(FETCH_STAMP):
    age = int(time.time()) - int(open(FETCH_STAMP).read().strip())
    if age < FETCH_TTL:
        remaining = (FETCH_TTL - age) // 60
        print(f"Skipping git pull (last fetch was {age // 60}m ago, next in {remaining}m).", file=sys.stderr)
        do_fetch = False

if do_fetch:
    print("Fetching latest commits across all repos...", file=sys.stderr)
    for repo in repos:
        repo_path = os.path.join(WORKSPACE, repo["dir"])
        if os.path.isdir(os.path.join(repo_path, ".git")):
            print(f"  git pull: {repo['dir']}", file=sys.stderr)
            subprocess.run(["git", "-C", repo_path, "fetch", "--all", "--quiet"],
                           capture_output=True)
            subprocess.run(["git", "-C", repo_path, "pull", "--ff-only", "--quiet"],
                           capture_output=True)
        else:
            print(f"  skip (not cloned): {repo['dir']}", file=sys.stderr)
    with open(FETCH_STAMP, "w") as f:
        f.write(str(int(time.time())))

print("", file=sys.stderr)

# ─── Git commits ──────────────────────────────────────────────────────────────

JIRA_KEY_RE = re.compile(r"\b([A-Z][A-Z0-9]{2,}[-\s]\d+)")

def extract_jira_keys(text):
    if not text:
        return []
    return list(set(m.replace(" ", "-") for m in JIRA_KEY_RE.findall(text)))

def get_git_commits(repo_dir, since, until):
    path = os.path.join(WORKSPACE, repo_dir)
    if not os.path.isdir(os.path.join(path, ".git")):
        return None
    result = subprocess.run(
        ["git", "log", "--all",
         f"--since={since}", f"--until={until}",
         "--format=%H%x1f%aN%x1f%aI%x1f%s"],
        cwd=path, capture_output=True, text=True,
    )
    commits = []
    for line in result.stdout.strip().split("\n"):
        if not line:
            continue
        parts = line.split("\x1f")
        if len(parts) < 4:
            continue
        hash_, author, date_str, subject = parts
        commits.append({
            "hash":      hash_[:10],
            "author":    resolve_author(author),
            "date":      date_str[:10],
            "message":   subject,
            "jira_keys": extract_jira_keys(subject),
        })
    return commits

# ─── GitHub PRs ───────────────────────────────────────────────────────────────

def github_slug(url):
    m = re.match(r"https?://github\.com/([^/]+/[^/]+?)(?:\.git)?/?$", url)
    if m:
        return m.group(1)
    m = re.match(r"git@github\.com:([^/]+/[^/]+?)(?:\.git)?$", url)
    if m:
        return m.group(1)
    return None

def get_github_prs(slug, since, until):
    if not GH_AVAILABLE or not slug:
        return None
    opened, merged = [], []
    for search_type, date_field, label in [
        ("created", "createdAt", "opened"),
        ("merged",  "mergedAt",  "merged"),
    ]:
        result = subprocess.run([
            "gh", "pr", "list", "-R", slug,
            "--state", "all",
            "--search", f"{search_type}:{since}..{until}",
            "--json", "number,title,author,url,headRefName,createdAt,mergedAt",
            "--limit", "200",
        ], capture_output=True, text=True)
        try:
            data = json.loads(result.stdout)
        except json.JSONDecodeError:
            print(f"  Warning: gh error for {slug} ({label})", file=sys.stderr)
            continue
        for pr in data:
            author   = resolve_author(pr.get("author", {}).get("login", "unknown"))
            title    = pr.get("title", "")
            branch   = pr.get("headRefName", "")
            jkeys    = list(set(extract_jira_keys(title) + extract_jira_keys(branch)))
            pr_base  = {
                "number":    pr["number"],
                "title":     title,
                "author":    author,
                "url":       pr.get("url", ""),
                "branch":    branch,
                "jira_keys": jkeys,
            }
            if label == "opened":
                opened.append({**pr_base, "created_at": pr.get("createdAt", "")[:10]})
            elif label == "merged" and pr.get("mergedAt"):
                merged.append({**pr_base, "merged_at": pr.get("mergedAt", "")[:10]})
    return {"opened": opened, "merged": merged}

# ─── Jira lookup ──────────────────────────────────────────────────────────────

def jira_post(endpoint, body):
    req = urllib.request.Request(
        f"{JIRA_URL}{endpoint}",
        data=json.dumps(body).encode(),
        headers={
            "Authorization": f"Basic {JIRA_AUTH}",
            "Content-Type":  "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        print(f"  Jira API error {e.code}: {e.read().decode()}", file=sys.stderr)
        return {}

def jira_batch_lookup(keys):
    if not JIRA_AUTH or not keys:
        return {}
    issues = {}
    for i in range(0, len(keys), 50):
        batch = keys[i:i + 50]
        data  = jira_post("/rest/api/3/search/jql", {
            "jql":        f'key in ({", ".join(batch)})',
            "fields":     ["key", "summary", "status", "issuetype", "assignee", "parent"],
            "maxResults": 50,
        })
        if "errorMessages" in data:
            print(f"  Jira error: {data['errorMessages']}", file=sys.stderr)
            continue
        for issue in data.get("issues", []):
            fields = issue.get("fields", {})
            parent = fields.get("parent")
            epic_info = None
            if parent:
                pf = parent.get("fields", {})
                epic_info = {
                    "key":     parent.get("key"),
                    "summary": pf.get("summary", ""),
                    "status":  pf.get("status", {}).get("name", ""),
                    "type":    pf.get("issuetype", {}).get("name", ""),
                }
            assignee = fields.get("assignee") or {}
            issues[issue["key"]] = {
                "key":      issue["key"],
                "summary":  fields.get("summary", ""),
                "type":     fields.get("issuetype", {}).get("name", ""),
                "status":   fields.get("status", {}).get("name", ""),
                "assignee": assignee.get("displayName", "Unassigned"),
                "epic":     epic_info,
            }
    return issues

# ─── Collect activity ─────────────────────────────────────────────────────────

activity        = {}
all_jira_keys   = set()
repos_skipped   = []
total_prs_opened = 0
total_prs_merged = 0

for repo in repos:
    print(f"Processing {repo['name']} ({repo['dir']})...", file=sys.stderr)
    slug = github_slug(repo["url"])
    proj = {"github_repo": slug, "commits": [], "pull_requests": {"opened": [], "merged": []}}

    commits = get_git_commits(repo["dir"], str(date_from), str(git_until))
    if commits is None:
        print("  Skipped (not cloned)", file=sys.stderr)
        repos_skipped.append(repo["name"])
        continue

    proj["commits"] = commits
    for c in commits:
        all_jira_keys.update(c["jira_keys"])

    prs = get_github_prs(slug, date_from, date_to)
    if prs:
        proj["pull_requests"]  = prs
        total_prs_opened      += len(prs["opened"])
        total_prs_merged      += len(prs["merged"])
        for pr in prs["opened"] + prs["merged"]:
            all_jira_keys.update(pr["jira_keys"])

    activity[repo["name"]] = proj

# ─── Jira enrichment ──────────────────────────────────────────────────────────

jira_issues = {}
jira_epics  = {}

if all_jira_keys:
    print(f"Looking up {len(all_jira_keys)} Jira issue(s)...", file=sys.stderr)
    jira_issues = jira_batch_lookup(list(all_jira_keys))

    epic_keys = {issue["epic"]["key"]
                 for issue in jira_issues.values()
                 if issue.get("epic") and issue["epic"].get("key")}

    missing_epics = [k for k in epic_keys if k not in jira_issues]
    epic_details  = jira_batch_lookup(missing_epics) if missing_epics else {}

    for ek in epic_keys:
        src             = epic_details.get(ek) or jira_issues.get(ek)
        related_issues  = [k for k, v in jira_issues.items()
                           if (v.get("epic") or {}).get("key") == ek]
        related_keys    = set(related_issues + [ek])
        devs, commits_n, prs_n = set(), 0, 0

        for proj in activity.values():
            for c in proj["commits"]:
                if related_keys & set(c["jira_keys"]):
                    devs.add(c["author"])
                    commits_n += 1
            for pr in proj["pull_requests"].get("opened", []) + proj["pull_requests"].get("merged", []):
                if related_keys & set(pr["jira_keys"]):
                    devs.add(pr["author"])
                    prs_n += 1

        entry = {
            "key":             ek,
            "issues_this_week": related_issues,
            "developers":      sorted(devs),
            "commits_count":   commits_n,
            "prs_count":       prs_n,
            "summary":         src.get("summary", "") if src else "",
            "status":          src.get("status", "")  if src else "",
        }
        if not src:
            for issue in jira_issues.values():
                ep = issue.get("epic")
                if ep and ep.get("key") == ek:
                    entry["summary"] = ep.get("summary", "")
                    entry["status"]  = ep.get("status", "")
                    break
        jira_epics[ek] = entry

# ─── Build developer summary ──────────────────────────────────────────────────

dev_data = defaultdict(lambda: {
    "commits_total":    0,
    "commits_by_proj":  {},
    "prs_opened":       0,
    "prs_merged":       0,
    "jira_issues":      set(),
})

for proj_name, proj in activity.items():
    for c in proj["commits"]:
        d = dev_data[c["author"]]
        d["commits_total"] += 1
        d["commits_by_proj"][proj_name] = d["commits_by_proj"].get(proj_name, 0) + 1
        d["jira_issues"].update(c["jira_keys"])
    for pr in proj["pull_requests"].get("opened", []):
        dev_data[pr["author"]]["prs_opened"] += 1
        dev_data[pr["author"]]["jira_issues"].update(pr["jira_keys"])
    for pr in proj["pull_requests"].get("merged", []):
        dev_data[pr["author"]]["prs_merged"] += 1
        dev_data[pr["author"]]["jira_issues"].update(pr["jira_keys"])

for d in dev_data.values():
    d["jira_issues"] = sorted(d["jira_issues"])

# ─── Build markdown report ────────────────────────────────────────────────────

def jira_link(key):
    return f"[{key}]({JIRA_URL}/browse/{key})" if JIRA_URL else key

def make_anchor(name):
    return re.sub(r"[^a-z0-9\- ]", "", name.lower()).strip().replace(" ", "-")

out = []
w   = out.append

from_str = date_from.strftime("%b %d")
to_str   = date_to.strftime("%b %d, %Y")
w(f"# Developer Progress Report — {from_str}–{to_str}\n")

if repos_skipped:
    w(f"> **Repos skipped (not cloned):** {', '.join(repos_skipped)}\n")

# Summary table
w("## Summary\n")
w("| Developer | Commits | PRs Opened | PRs Merged | Projects |")
w("|-----------|---------|------------|------------|----------|")
for dev_name in sorted(dev_data, key=str.lower):
    d = dev_data[dev_name]
    project_commits = defaultdict(int)
    for proj_name, count in d["commits_by_proj"].items():
        project_commits[project_for_repo(proj_name)] += count
    projects_str = ", ".join(f"{project} ({n})" for project, n in sorted(project_commits.items()))
    w(f"| [{dev_name}](#{make_anchor(dev_name)}) | {d['commits_total']} "
      f"| {d['prs_opened']} | {d['prs_merged']} | {projects_str} |")
w("")

# Per-developer detail
for dev_name in sorted(dev_data, key=str.lower):
    d = dev_data[dev_name]
    w(f"---\n\n## {dev_name}\n")

    projects_str = ", ".join(
        f"{project_for_repo(p)} ({n})" for p, n in sorted(d["commits_by_proj"].items())
    )
    parts = []
    if d["commits_total"]: parts.append(f"{d['commits_total']} commits")
    if d["prs_opened"]:    parts.append(f"{d['prs_opened']} PRs opened")
    if d["prs_merged"]:    parts.append(f"{d['prs_merged']} PRs merged")
    if projects_str: w(f"**Projects:** {projects_str}  ")
    if parts:    w(f"**Activity:** {', '.join(parts)}\n")

    dev_prs_opened = [(pn, pr) for pn, proj in activity.items()
                      for pr in proj["pull_requests"].get("opened", [])
                      if pr["author"] == dev_name]
    dev_prs_merged = [(pn, pr) for pn, proj in activity.items()
                      for pr in proj["pull_requests"].get("merged", [])
                      if pr["author"] == dev_name]

    def pr_jira_tag(pr):
        if not pr.get("jira_keys"):
            return ""
        parts = []
        for jk in pr["jira_keys"]:
            ji = jira_issues.get(jk)
            link = jira_link(jk)
            parts.append(f"{link}: {ji['summary']}" if ji else link)
        return " — " + "; ".join(parts)

    if dev_prs_opened:
        w("### PRs Opened\n")
        for proj_name, pr in dev_prs_opened:
            w(f"- [{proj_name} #{pr['number']}]({pr['url']}): {pr['title']}{pr_jira_tag(pr)}")
        w("")

    if dev_prs_merged:
        w("### PRs Merged\n")
        for proj_name, pr in dev_prs_merged:
            w(f"- [{proj_name} #{pr['number']}]({pr['url']}): {pr['title']}{pr_jira_tag(pr)}")
        w("")

    if d["commits_total"]:
        w("### Commits\n")
        for proj_name, proj in activity.items():
            dev_commits = [c for c in proj["commits"] if c["author"] == dev_name]
            if not dev_commits:
                continue
            w(f"**{project_for_repo(proj_name)}** ({len(dev_commits)}):\n")
            for c in dev_commits:
                jira_prefix = ""
                if c["jira_keys"]:
                    jira_prefix = " ".join(jira_link(jk) for jk in c["jira_keys"]) + " "
                w(f"- {jira_prefix}{c['message']}  <sub>{c['date']}</sub>")
            w("")

    resolved = [jira_issues[k] for k in d["jira_issues"] if k in jira_issues]
    if resolved:
        w("### Jira Tickets\n")
        w("| Ticket | Summary | Type | Status | Epic |")
        w("|--------|---------|------|--------|------|")
        for t in sorted(resolved, key=lambda x: x["key"]):
            ep        = t.get("epic")
            epic_str  = "—"
            if ep and ep.get("key"):
                epic_str = f"{jira_link(ep['key'])}: {ep['summary']}"
            summary      = t["summary"][:60] + ("..." if len(t["summary"]) > 60 else "")
            epic_display = epic_str[:60]       + ("..." if len(epic_str)    > 60 else "")
            w(f"| {jira_link(t['key'])} | {summary} | {t['type']} | {t['status']} | {epic_display} |")
        w("")

# Epic overview
if jira_epics:
    w("---\n\n## Epic Overview\n")
    for ek, epic in sorted(jira_epics.items(), key=lambda x: x[1].get("summary", "").lower()):
        issues_str = ", ".join(jira_link(ik) for ik in epic.get("issues_this_week", []))
        devs_str   = ", ".join(epic.get("developers", []))
        w(f"### {jira_link(ek)}: {epic.get('summary', '')}\n")
        w(f"- **Status:** {epic.get('status', '')}")
        w(f"- **Developers:** {devs_str}")
        w(f"- **Issues touched:** {issues_str}")
        w(f"- **Activity:** {epic['commits_count']} commits, {epic['prs_count']} PRs")
        w("")

total_commits = sum(d["commits_total"] for d in dev_data.values())
n_epics       = len(jira_epics)
w(f"\n---\n*Generated {datetime.now().strftime('%Y-%m-%d %H:%M')} — "
  f"{len(dev_data)} developers, {total_commits} commits, "
  f"{total_prs_opened} PRs opened, {total_prs_merged} merged, "
  f"{n_epics} epics*")

# ─── Write output ─────────────────────────────────────────────────────────────

os.makedirs(REPORTS_DIR, exist_ok=True)

if args.output:
    outfile = args.output
elif args.date_from:
    outfile = os.path.join(REPORTS_DIR, f"dev-progress-weekly-report-{args.date_from}.md")
elif args.week:
    outfile = os.path.join(REPORTS_DIR, f"dev-progress-weekly-report-{args.week}.md")
else:
    outfile = os.path.join(REPORTS_DIR, f"dev-progress-weekly-report-{today}.md")

with open(outfile, "w") as f:
    f.write("\n".join(out) + "\n")

print(f"\nDone. {len(dev_data)} developer(s), {total_commits} commit(s), "
      f"{total_prs_opened} PR(s) opened, {total_prs_merged} merged, "
      f"{n_epics} epic(s).", file=sys.stderr)
print(outfile)
