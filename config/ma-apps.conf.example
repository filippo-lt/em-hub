crashlytics_bq_table = project.firebase_crashlytics.stepcounter_ANDROID
gcp_billing_filter   = labels.app = "stepcounter"
studio_cost_eur      = 0

[app:Truth Seeker]
# pre-launch (Apple-blocked) — most live metrics will be n/a until it ships
posture          = Sunset
studio           = Helikanon
github_repo      = rosseca/truth-seeker
revenuecat_project =
amplitude_app_id   =
crashlytics_bq_table =
gcp_billing_filter   = labels.app = "truthseeker"
studio_cost_eur      = 0

[app:Music Player]
posture          = Sunset
